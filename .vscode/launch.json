{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Flask App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/my app/app.py",
            "cwd": "${workspaceFolder}/my app",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "True"
            }
        }
    ]
}
