# Environment Variables — copy this file to .env and fill in your values.
# .env is gitignored so secrets are never committed to GitHub.
#
# HOW TO GET A SHARED DATABASE (so all devs & Render see the same data):
#   1. Go to your Render dashboard → the vapecrib-db PostgreSQL service
#   2. Copy the "External Connection String" (starts with postgresql://)
#   3. Paste it below as DATABASE_URL
#   Render will auto-set DATABASE_URL in production via render.yaml.
#
# If DATABASE_URL is left blank, the app falls back to local SQLite (your own data only).

FLASK_ENV=development
SECRET_KEY=your-secret-key-here-generate-with-secrets-token-hex-32chars
DATABASE_URL=postgresql://user:password@host:5432/database
FLASK_DEBUG=True
FLASK_PORT=5000
