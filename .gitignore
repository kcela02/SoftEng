# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Flask / SQLite ─────────────────────────────────────────────────────────────
# SQLite database (each dev has their own; Render uses PostgreSQL via DATABASE_URL)
my app/instance/
instance/
*.db
*.sqlite
*.sqlite3

# ── Secrets ────────────────────────────────────────────────────────────────────
.env
my app/.env
# .env.example is intentionally NOT ignored — it's the template for collaborators

# ── Trained model files ────────────────────────────────────────────────────────
my app/models/instance/
my app/instance/models/
*.pkl

# ── Data / handoff folder (share privately, not via git) ──
_for_collaborators/
my app/data/*.csv
my app/sample_*.csv
# ── Documentation files ───────────────────────────────────────────────────────
Document/

# ── Dev-only scripts (local use only, not for deployment) ──────────────────────
/runtime.txt
/test_csrf.py
my app/migrate_to_render.py

# ── OS / editor ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
